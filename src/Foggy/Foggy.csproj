<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Foggy</AssemblyName>
    <Product>Foggy</Product>
    <Version>0.1.0</Version>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Foggy</RootNamespace>
    <NoStdLib>true</NoStdLib>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <RestoreSources></RestoreSources>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <!-- Base class libraries from Unity Mono (net35-equivalent) -->
  <ItemGroup>
    <Reference Include="mscorlib">
      <HintPath>$(GAME_MANAGED)/mscorlib.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System">
      <HintPath>$(GAME_MANAGED)/System.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="System.Core">
      <HintPath>$(GAME_MANAGED)/System.Core.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- BepInEx & Harmony -->
  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(BEPINEX_CORE)/BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(BEPINEX_CORE)/0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Timer extension APIs: HSRTimer and its TwilightTimer fork (build each
       first, same Configuration). Referenced side by side — the namespaces
       differ, so the types never collide; at runtime only the installed
       fork's types are ever touched (see TimerBridges.cs). -->
  <ItemGroup>
    <Reference Include="HSRTimer">
      <HintPath>$(HSRTIMER_DIR)/src/HSRTimer/bin/$(Configuration)/netstandard2.0/HSRTimer.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TwilightTimer">
      <HintPath>$(TWILIGHTTIMER_DIR)/src/TwilightTimer/bin/$(Configuration)/netstandard2.0/TwilightTimer.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Game assemblies (CaveRender, FreeRoamCam, Multiplayer.App/AppSate) -->
  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GAME_MANAGED)/Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Unity engine modules (only what Foggy uses; UnityEngine is the type-
       forwarding facade BepInEx's BaseUnityPlugin was compiled against) -->
  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GAME_MANAGED)/UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GAME_MANAGED)/UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

</Project>
